<UserControl x:Class="PingByDaylight.Presentation.Components.RegionGroupComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:PingByDaylight.Presentation.Components"
             mc:Ignorable="d">
    
    <Expander Margin="0,8" 
              IsExpanded="True"
              Background="Transparent"
              BorderThickness="0">
        <Expander.Header>
            <Border Background="{StaticResource SecondaryBrush}"
                    CornerRadius="8"
                    Padding="15,12"
                    Width="{Binding RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}, Path=ActualWidth, Converter={StaticResource MinusMarginConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                             Text="{Binding DisplayName}" 
                             FontWeight="SemiBold" 
                             FontSize="15"
                             Foreground="{StaticResource TextBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" 
                             Text="{Binding Servers.Count, StringFormat={}{0} серверов}" 
                             FontSize="12"
                             Foreground="{StaticResource SubTextBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,15,0"/>
                    <!-- Best Ping Badge -->
                    <Border Grid.Column="2"
                            Background="#FF1E1E1E"
                            CornerRadius="6"
                            Padding="10,4"
                            Visibility="{Binding BestPingVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm0 4H9v-2h2v2z" 
                                  Fill="{StaticResource SuccessBrush}" 
                                  Width="14" Height="14"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding BestPingDisplay}" 
                                     Foreground="{StaticResource SuccessBrush}"
                                     FontSize="12"
                                     FontWeight="Bold"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Expander.Header>
        <Expander.Content>
            <ItemsControl ItemsSource="{Binding Servers}" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <components:ServerItemComponent/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander.Content>
    </Expander>
</UserControl>
