<UserControl x:Class="PingByDaylight.Presentation.Components.ServerItemComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    
    <Border Background="{StaticResource SecondaryBrush}" 
            CornerRadius="10" 
            Margin="0,6" 
            Padding="16"
            BorderBrush="{Binding StatusColor, Converter={StaticResource ColorToBrushConverter}}"
            BorderThickness="2"
            SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Cursor" Value="Arrow"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF323232"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Checkbox -->
            <CheckBox Grid.Row="0" 
                    Grid.Column="0"
                    IsChecked="{Binding IsSelected}" 
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    Style="{StaticResource ModernCheckBox}"/>
            
            <!-- Server Info -->
            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding ServerInfo.DisplayName}" 
                         Foreground="{StaticResource TextBrush}"
                         FontSize="14"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ServerInfo.Key}" 
                         Foreground="{StaticResource SubTextBrush}"
                         FontSize="11"
                         Margin="0,2,0,0"
                         FontStyle="Italic"/>
            </StackPanel>
            
            <!-- Quality Badge / Loading Indicator -->
            <Border Grid.Row="0" 
                  Grid.Column="2"
                  CornerRadius="6"
                  Padding="10,4"
                  MinWidth="60"
                  HorizontalAlignment="Right">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding StatusColor}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProbing}" Value="True">
                                <Setter Property="Background" Value="#FF3A3A3A"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- Loading Spinner -->
                    <ProgressRing IsActive="{Binding IsProbing}" 
                                 Width="20" Height="20"
                                 Foreground="{StaticResource AccentBrush}"
                                 Visibility="{Binding IsProbing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <!-- Quality Badge Text -->
                    <TextBlock Text="{Binding QualityBadge}" 
                             Foreground="White"
                             FontSize="12"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             Visibility="{Binding IsProbing, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                </Grid>
            </Border>
            
            <!-- Metrics Row -->
            <Grid Grid.Row="1" 
                Grid.Column="0" 
                Grid.ColumnSpan="3"
                Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Ping & Loss -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FF1E1E1E" 
                            CornerRadius="6" 
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm0 4H9v-2h2v2z" 
                                  Fill="{StaticResource SubTextBrush}" 
                                  Width="14" Height="14"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ping: " 
                                         Foreground="{StaticResource SubTextBrush}"
                                         FontSize="12"/>
                                <TextBlock Text="{Binding DisplayLatency}"
                                         Foreground="{Binding StatusColor}"
                                         FontSize="13"
                                         FontWeight="Bold"/>
                                <TextBlock Text=" мс" 
                                         Foreground="{StaticResource SubTextBrush}"
                                         FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="#FF1E1E1E" 
                            CornerRadius="6" 
                            Padding="10,6"
                            Margin="8,0,0,0"
                            Visibility="{Binding PacketLossPercent, Converter={StaticResource DoubleToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 2L1 21h22L12 2zm1 16h-2v-2h2v2zm0-4h-2V9h2v5z" 
                                  Fill="{StaticResource ErrorBrush}" 
                                  Width="14" Height="14"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding DisplayPacketLoss}"
                                     Foreground="{StaticResource ErrorBrush}"
                                     FontSize="13"
                                     FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- Probe Button -->
                <Button Grid.Column="1" 
                      Content="Проверить" 
                      Style="{StaticResource IconButton}"
                      Command="{Binding ProbeCommand}"
                      ToolTip="Проверить пинг"
                      Padding="12,6"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
