<Window x:Class="PingByDaylight.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:components="clr-namespace:PingByDaylight.Presentation.Components"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        Height="800" Width="550"
        MinHeight="600" MinWidth="450"
        WindowStartupLocation="CenterScreen"
        Background="#FF0A0A0A"
        FontFamily="Segoe UI Variable"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource PrimaryBrush}" 
                Padding="20,15"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <components:HeaderMenuComponent x:Name="HeaderMenu"/>
        </Border>

        <!-- Context Menu (Popup) -->
        <Popup Grid.Row="0" 
               PlacementTarget="{Binding ElementName=HeaderMenu, Path=MenuButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource PrimaryBrush}" 
                    CornerRadius="8"
                    Padding="8"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Effect="{StaticResource DropShadowEffect}">
                <StackPanel>
                    <Button Content="Настройки" 
                            Style="{StaticResource MenuItemButton}"
                            Command="{Binding OpenSettingsCommand}"/>
                    <Button Content="О программе" 
                            Style="{StaticResource MenuItemButton}"
                            Command="{Binding OpenAboutCommand}"/>
                    <Separator Background="{StaticResource BorderBrush}" Margin="8,4"/>
                    <Button Content="Проверить обновления" 
                            Style="{StaticResource MenuItemButton}"
                            Command="{Binding CheckUpdatesCommand}"/>
                    <Button Content="Информация о подключении" 
                            Style="{StaticResource MenuItemButton}"
                            Command="{Binding OpenConnectionInfoCommand}"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Quick Stats Bar -->
        <Border Grid.Row="1" 
                Margin="20,15,20,10">
            <components:QuickStatsComponent/>
        </Border>

        <!-- Server List -->
        <Border Grid.Row="2" 
                Background="{StaticResource PrimaryBrush}" 
                CornerRadius="12" 
                Margin="20,0,20,15"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                         Padding="15"
                         Style="{StaticResource ModernScrollViewer}">
                <ItemsControl ItemsSource="{Binding ServerGroups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <components:RegionGroupComponent/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" 
                Margin="20,0,20,15">
            <components:StatusBarComponent/>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="4" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" 
                  Content="Сбросить выбор" 
                  Style="{StaticResource SecondaryButton}"
                  Command="{Binding ResetSelectionCommand}"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                  HorizontalAlignment="Stretch"
                  Padding="16,12"/>
            
            <Button Grid.Column="1" 
                  Content="Запустить пинг всех серверов" 
                  Style="{StaticResource ModernButton}"
                  Command="{Binding ProbeAllCommand}"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                  HorizontalAlignment="Stretch"
                  Padding="16,12"
                  Margin="10,0"/>
            
            <Button Grid.Column="2" 
                  Content="Применить" 
                  Style="{StaticResource ModernButton}"
                  Command="{Binding ApplySelectionCommand}"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                  HorizontalAlignment="Stretch"
                  Padding="16,12"/>
        </Grid>

        <!-- Busy Overlay - показывается только при загрузке/инициализации -->
        <Grid Grid.RowSpan="5" 
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#CC000000" 
                    CornerRadius="12"
                    Margin="20"/>
            <StackPanel VerticalAlignment="Center" 
                      HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                           Width="200" 
                           Height="4"
                           Foreground="{StaticResource AccentBrush}"
                           Style="{StaticResource ModernProgressBar}"/>
                <TextBlock Text="Загрузка..." 
                         Foreground="{StaticResource TextBrush}"
                         FontSize="14"
                         Margin="0,15,0,0"
                         HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
