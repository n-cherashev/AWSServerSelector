<Window x:Class="PingByDaylight.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        Height="800" Width="550"
        MinHeight="600" MinWidth="450"
        WindowStartupLocation="CenterScreen"
        Background="#FF0A0A0A"
        FontFamily="Segoe UI Variable"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource PrimaryBrush}" 
                Padding="20,15"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Ping By Daylight" 
                             FontSize="20" 
                             FontWeight="Bold" 
                             Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Выберите регион для подключения" 
                             FontSize="12" 
                             Foreground="{StaticResource SubTextBrush}"
                             Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Menu Button -->
                <Button x:Name="HeaderMenuBtn"
                        Grid.Column="1" 
                        Width="40" Height="40"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Меню">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Path Data="M3,6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z" 
                          Fill="{StaticResource TextBrush}" 
                          Width="20" Height="20"/>
                </Button>
            </Grid>
        </Border>

        <!-- Context Menu (Popup) -->
        <Popup Grid.Row="0" 
               PlacementTarget="{Binding ElementName=HeaderMenuBtn}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource PrimaryBrush}" 
                    CornerRadius="8"
                    Padding="8"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Effect="{StaticResource DropShadowEffect}">
                <StackPanel>
                    <Button Content="Настройки" 
                            Style="{StaticResource MenuItemButton}"
                            Command="{Binding OpenSettingsCommand}"/>
                    <Button Content="О программе" 
                            Style="{StaticResource MenuItemButton}"
                            Command="{Binding OpenAboutCommand}"/>
                    <Separator Background="{StaticResource BorderBrush}" Margin="8,4"/>
                    <Button Content="Проверить обновления" 
                            Style="{StaticResource MenuItemButton}"
                            Command="{Binding CheckUpdatesCommand}"/>
                    <Button Content="Информация о подключении" 
                            Style="{StaticResource MenuItemButton}"
                            Command="{Binding OpenConnectionInfoCommand}"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Quick Stats Bar -->
        <Border Grid.Row="1" 
                Background="{StaticResource SecondaryBrush}" 
                Padding="15,10"
                Margin="20,15,20,10"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Регионов" 
                             FontSize="11" 
                             Foreground="{StaticResource SubTextBrush}"
                             HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalRegionsCount}" 
                             FontSize="18" 
                             FontWeight="Bold" 
                             Foreground="{StaticResource TextBrush}"
                             HorizontalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Выбрано" 
                             FontSize="11" 
                             Foreground="{StaticResource SubTextBrush}"
                             HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedCount}" 
                             FontSize="18" 
                             FontWeight="Bold" 
                             Foreground="{StaticResource AccentBrush}"
                             HorizontalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Средний пинг" 
                             FontSize="11" 
                             Foreground="{StaticResource SubTextBrush}"
                             HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AverageLatency}" 
                             FontSize="18" 
                             FontWeight="Bold" 
                             Foreground="{StaticResource SuccessBrush}"
                             HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Server List -->
        <Border Grid.Row="2" 
                Background="{StaticResource PrimaryBrush}" 
                CornerRadius="12" 
                Margin="20,0,20,15"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                         Padding="15"
                         Style="{StaticResource ModernScrollViewer}">
                <ItemsControl ItemsSource="{Binding ServerGroups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Margin="0,8" 
                                      IsExpanded="True"
                                      Background="Transparent"
                                      BorderThickness="0">
                                <Expander.Header>
                                    <Border Background="{StaticResource SecondaryBrush}"
                                            CornerRadius="8"
                                            Padding="15,12"
                                            Width="{Binding RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}, Path=ActualWidth, Converter={StaticResource MinusMarginConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" 
                                                     Text="{Binding DisplayName}" 
                                                     FontWeight="SemiBold" 
                                                     FontSize="15"
                                                     Foreground="{StaticResource TextBrush}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" 
                                                     Text="{Binding Servers.Count, StringFormat={}{0} серверов}" 
                                                     FontSize="12"
                                                     Foreground="{StaticResource SubTextBrush}"
                                                     VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Expander.Header>
                                <Expander.Content>
                                    <ItemsControl ItemsSource="{Binding Servers}" Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SecondaryBrush}" 
                                                        CornerRadius="10" 
                                                        Margin="0,6" 
                                                        Padding="16"
                                                        BorderBrush="{Binding StatusColor, Converter={StaticResource ColorToBrushConverter}}"
                                                        BorderThickness="2"
                                                        SnapsToDevicePixels="True">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Cursor" Value="Arrow"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#FF323232"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        
                                                        <!-- Checkbox -->
                                                        <CheckBox Grid.Row="0" 
                                                                Grid.Column="0"
                                                                IsChecked="{Binding IsSelected}" 
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,12,0"
                                                                Style="{StaticResource ModernCheckBox}"/>
                                                        
                                                        <!-- Server Info -->
                                                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ServerInfo.DisplayName}" 
                                                                     Foreground="{StaticResource TextBrush}"
                                                                     FontSize="14"
                                                                     FontWeight="SemiBold"
                                                                     TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding ServerInfo.Key}" 
                                                                     Foreground="{StaticResource SubTextBrush}"
                                                                     FontSize="11"
                                                                     Margin="0,2,0,0"
                                                                     FontStyle="Italic"/>
                                                        </StackPanel>
                                                        
                                                        <!-- Quality Badge -->
                                                        <Border Grid.Row="0" 
                                                              Grid.Column="2"
                                                              Background="{Binding StatusColor}"
                                                              CornerRadius="6"
                                                              Padding="10,4"
                                                              MinWidth="60"
                                                              HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding QualityBadge}" 
                                                                     Foreground="White"
                                                                     FontSize="12"
                                                                     FontWeight="Bold"
                                                                     HorizontalAlignment="Center"/>
                                                        </Border>
                                                        
                                                        <!-- Metrics Row -->
                                                        <Grid Grid.Row="1" 
                                                            Grid.Column="0" 
                                                            Grid.ColumnSpan="3"
                                                            Margin="0,12,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <!-- Ping & Loss -->
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Background="#FF1E1E1E" 
                                                                        CornerRadius="6" 
                                                                        Padding="10,6">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm0 4H9v-2h2v2z" 
                                                                              Fill="{StaticResource SubTextBrush}" 
                                                                              Width="14" Height="14"
                                                                              VerticalAlignment="Center"
                                                                              Margin="0,0,6,0"/>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="Ping: " 
                                                                                     Foreground="{StaticResource SubTextBrush}"
                                                                                     FontSize="12"/>
                                                                            <TextBlock Text="{Binding DisplayLatency}"
                                                                                     Foreground="{Binding StatusColor}"
                                                                                     FontSize="13"
                                                                                     FontWeight="Bold"/>
                                                                            <TextBlock Text=" мс" 
                                                                                     Foreground="{StaticResource SubTextBrush}"
                                                                                     FontSize="12"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                                
                                                                <Border Background="#FF1E1E1E" 
                                                                        CornerRadius="6" 
                                                                        Padding="10,6"
                                                                        Margin="8,0,0,0"
                                                                        Visibility="{Binding PacketLossPercent, Converter={StaticResource DoubleToVisibilityConverter}}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Path Data="M12 2L1 21h22L12 2zm1 16h-2v-2h2v2zm0-4h-2V9h2v5z" 
                                                                              Fill="{StaticResource ErrorBrush}" 
                                                                              Width="14" Height="14"
                                                                              VerticalAlignment="Center"
                                                                              Margin="0,0,6,0"/>
                                                                        <TextBlock Text="{Binding DisplayPacketLoss}"
                                                                                 Foreground="{StaticResource ErrorBrush}"
                                                                                 FontSize="13"
                                                                                 FontWeight="Bold"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                            
                                                            <!-- Probe Button -->
                                                            <Button Grid.Column="1" 
                                                                  Content="Проверить" 
                                                                  Style="{StaticResource IconButton}"
                                                                  Command="{Binding ProbeCommand}"
                                                                  ToolTip="Проверить пинг"
                                                                  Padding="12,6"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander.Content>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" 
                Background="{StaticResource SecondaryBrush}" 
                CornerRadius="8" 
                Padding="15,10"
                Margin="20,0,20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Ellipse Grid.Column="0" 
                        Width="10" Height="10" 
                        Fill="{Binding StatusIndicatorColor}"
                        Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" 
                         Text="{Binding StatusMessage}" 
                         Foreground="{StaticResource TextBrush}"
                         FontSize="13"
                         VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="4" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" 
                  Content="Сбросить выбор" 
                  Style="{StaticResource SecondaryButton}"
                  Command="{Binding ResetSelectionCommand}"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                  HorizontalAlignment="Stretch"
                  Padding="16,12"/>
            
            <Button Grid.Column="2" 
                  Content="Применить" 
                  Style="{StaticResource ModernButton}"
                  Command="{Binding ApplySelectionCommand}"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                  HorizontalAlignment="Stretch"
                  Padding="16,12"/>
        </Grid>

        <!-- Busy Overlay -->
        <Grid Grid.RowSpan="5" 
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#CC000000" 
                    CornerRadius="12"
                    Margin="20"/>
            <StackPanel VerticalAlignment="Center" 
                      HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                           Width="200" 
                           Height="4"
                           Foreground="{StaticResource AccentBrush}"
                           Style="{StaticResource ModernProgressBar}"/>
                <TextBlock Text="Проверка регионов..." 
                         Foreground="{StaticResource TextBrush}"
                         FontSize="14"
                         Margin="0,15,0,0"
                         HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
