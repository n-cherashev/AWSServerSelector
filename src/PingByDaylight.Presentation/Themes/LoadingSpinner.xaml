<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:components="clr-namespace:PingByDaylight.Presentation.Components">

    <!-- LoadingSpinner Control Template -->
    <Style TargetType="{x:Type components:LoadingSpinner}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type components:LoadingSpinner}">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <Border Width="18" Height="18"
                                BorderBrush="{TemplateBinding Foreground}"
                                BorderThickness="3"
                                CornerRadius="9"
                                Opacity="0.3"/>
                        <Border Width="18" Height="18"
                                BorderBrush="{TemplateBinding Foreground}"
                                BorderThickness="3"
                                CornerRadius="9"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform x:Name="PART_RotateTransform" Angle="0"/>
                            </Border.RenderTransform>
                            <Border.Clip>
                                <RectangleGeometry Rect="-9,-9 9,18"/>
                            </Border.Clip>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="PART_RotateTransform" Property="Angle" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
